---
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/cinzel/900.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/im-fell-english/400.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/700.css';
import { site, profile } from '../data/profile';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} · ${profile.name}`,
  description = profile.bio,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main-content">跳到主要内容</a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import Lenis from 'lenis';

      const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* 古典藏书配色 */
    --paper: #f2ead6;
    --paper-warm: #e9dcc0;
    --card: #f8f1e0;
    --ink: #2e241a;
    --ink-soft: #6b5a44;
    --ink-faint: #9a8a6e;
    --line: #d9c9a8;
    --accent: #a63f2e;
    --accent-soft: #ecd9c3;
    --gold: #b8933f;
    --dark: #16100b;
    --radius: 14px;

    --serif: 'Noto Serif SC', 'Songti SC', 'STSong', Georgia, 'Times New Roman', serif;
    --roman: 'Cinzel', 'Noto Serif SC', Georgia, serif;
    --cormorant: 'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
    --fell: 'IM Fell English', 'Cormorant Garamond', Georgia, serif;
    --sans:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--sans);
    background: var(--paper);
    color: var(--ink);
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  /* 旧纸纹理：极淡的横向纤维感 */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0 31px,
      rgba(46, 36, 26, 0.025) 31px 32px
    );
    z-index: -1;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  ::selection {
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* 烫金装饰小字 */
  .gold {
    color: var(--gold);
  }

  .container {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--ink);
    color: var(--paper);
    padding: 8px 16px;
    z-index: 100;
  }

  .skip:focus {
    left: 8px;
    top: 8px;
  }

  /* ===== 编辑排版通用元素 ===== */

  /* 英文小标签：EDITOR'S PICKS 这类 */
  .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    font-family: var(--roman);
  }

  /* 衬线大标题 */
  .display {
    font-family: var(--serif);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  /* 链接下划线风格 */
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent);
    border-bottom: 1.5px solid var(--accent);
    padding-bottom: 2px;
    transition: gap 0.2s;
  }

  .link-arrow:hover {
    gap: 10px;
  }

  /* 区块标题行（左标题 + 右侧可选链接） */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .section-head h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 700;
  }
</style>
