---
// 个人名片站独立布局 —— 极简浅色，与古籍主站完全分离
import { card, contact } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${card.name} · 个人名片`,
  description = `${card.bio1} · ${card.bio2}`,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script define:vars={{ wechatId: contact.wechat }}>
      // 点击 [data-copy] 元素复制微信号
      document.querySelectorAll('[data-copy]').forEach((el) => {
        el.addEventListener('click', async (e) => {
          e.preventDefault();
          const toast = document.getElementById('toast');
          try {
            await navigator.clipboard.writeText(wechatId);
            toast.textContent = '微信号已复制：' + wechatId;
          } catch {
            toast.textContent = '微信号：' + wechatId;
          }
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2200);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --c-card: #ffffff;
    --c-ink: #1d1d1f;
    --c-soft: #6e6e73;
    --c-faint: #86868b;
    --c-line: #d2d2d7;
    --c-accent: #0071e3;
    --c-onbg: #1d1d1f;
    --c-onbg-soft: #6e6e73;
    --c-onbg-faint: #86868b;
    --c-radius: 18px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    background: #f5f5f7;
    color: var(--c-onbg);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .page {
    max-width: 430px;
    margin: 0 auto;
    padding: 56px 20px 48px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ===== 白卡片 ===== */
  .cc {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: var(--c-card);
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: var(--c-radius);
    padding: 20px 22px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .cc:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.09);
  }

  .cc-title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--c-ink);
  }

  .cc-desc {
    font-size: 0.82rem;
    color: var(--c-soft);
    margin-top: 2px;
  }

  .cc-arrow {
    color: var(--c-faint);
    font-size: 1.1rem;
    flex-shrink: 0;
    transition: transform 0.2s, color 0.2s;
  }

  .cc:hover .cc-arrow {
    transform: translateX(3px);
    color: var(--c-accent);
  }

  /* ===== 返回链接 ===== */
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--c-onbg-soft);
    margin-bottom: 26px;
    width: fit-content;
  }

  .back:hover {
    color: var(--c-accent);
  }

  /* ===== 子页标题 ===== */
  .sub-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
    color: var(--c-onbg);
  }

  .sub-lead {
    font-size: 0.88rem;
    color: var(--c-onbg-soft);
    margin-bottom: 26px;
  }

  /* ===== 底部交叉链接 ===== */
  .more {
    margin-top: auto;
    padding-top: 34px;
  }

  .more-label {
    font-size: 0.78rem;
    color: var(--c-onbg-faint);
    margin-bottom: 10px;
  }

  .more .cc {
    padding: 15px 18px;
    margin-bottom: 10px;
  }

  .more .cc-title {
    font-size: 0.92rem;
  }

  .more .cc-desc {
    font-size: 0.78rem;
  }

  /* ===== 复制 toast ===== */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 40px;
    transform: translateX(-50%) translateY(12px);
    background: rgba(28, 31, 38, 0.92);
    color: #fff;
    font-size: 0.85rem;
    padding: 10px 20px;
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s, transform 0.25s;
    white-space: nowrap;
  }

  .toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>
