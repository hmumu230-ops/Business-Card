---
interface Props {
  num: string;
  title: string;
  id?: string;
}

const { num, title, id } = Astro.props;
---

<div class="numbered-head" id={id}>
  <span class="num">{num}</span>
  <h2 class="display">{title}</h2>
  <span class="rule"></span>
</div>

<style>
  .numbered-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 26px;
  }

  .num {
    font-family: var(--serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.08em;
  }

  h2 {
    font-size: 1.5rem;
  }

  .rule {
    flex: 1;
    height: 1px;
    background: var(--line);
    transform: translateY(-4px);
  }
</style>
