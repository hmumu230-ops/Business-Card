---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const books = await getCollection('reading');
const order = ['atomic-habits', 'cognitive-awakening', 'thinking-fast-slow'];
books.sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

<Base title="阅读 · Reading">
  <section class="container lib-hero">
    <p class="eyebrow">Reading · 阅读</p>
    <span class="hairline" aria-hidden="true"></span>
    <h1 class="display">读过的书，蒸馏成册</h1>
    <p class="lib-sub">每本都逐章精读、按「问题—论点—案例」结构蒸馏。点书名，读全部。</p>
    <p class="pub-line">Guangzhou · MMXXVI</p>
  </section>

  <section class="shelf-room">
    <div class="container">
      <div class="room-head">
        <h2 class="room-title"><span class="fleuron" aria-hidden="true">❦</span> 书目</h2>
        <p class="room-note">{books.length} 本已蒸馏</p>
      </div>

      <ol class="biblio">
        {books.map((b, i) => (
          <li>
            <a class="b-row" href={`/reading/${b.id}`}>
              <span class="b-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="b-main">
                <b class="b-title">{b.data.title}</b>
                <i class="b-desc">{b.data.author} · {b.data.en} · {b.data.sections} 篇蒸馏内容</i>
              </span>
              <span class="b-side">
                <em class="b-tag">已蒸馏</em>
                <span class="b-go">阅读 →</span>
              </span>
            </a>
          </li>
        ))}
        <li class="b-soon">
          <span class="b-num" aria-hidden="true">…</span>
          <span class="b-main">
            <b class="b-title">虚位以待</b>
            <i class="b-desc">下一本正在读，还没有蒸馏完。</i>
          </span>
          <span class="b-side"><em class="b-tag">Soon</em></span>
        </li>
      </ol>

      <p class="back-line"><a class="link-arrow" href="/library">← 返回书架</a></p>
    </div>
  </section>
</Base>

<style>
  .lib-hero {
    padding: 88px 24px 64px;
    text-align: center;
  }
  .hairline {
    display: block;
    width: 140px;
    height: 1px;
    margin: 20px auto 26px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .lib-hero h1 {
    font-size: 2.15rem;
    margin: 0 auto 16px;
    max-width: 620px;
  }
  .lib-sub {
    font-family: var(--cormorant);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ink-soft);
    max-width: 520px;
    margin: 0 auto;
  }
  .pub-line {
    font-family: var(--roman);
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 28px;
  }

  .shelf-room {
    background: #f5f5f7;
    color: var(--ink);
    padding: 58px 0 76px;
  }
  .room-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }
  .room-title {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .fleuron { color: var(--ink-faint); }
  .room-note {
    font-size: 0.8rem;
    color: var(--ink-faint);
    margin: 0;
  }

  .biblio { list-style: none; margin: 0; padding: 0; }
  .b-row {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 22px 10px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    transition: background 0.2s, padding-left 0.2s;
  }
  .b-row:hover { background: #fff; padding-left: 20px; }
  .b-num {
    font-family: var(--roman);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink-faint);
    flex-shrink: 0;
    width: 30px;
  }
  .b-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .b-title {
    font-family: var(--serif);
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--ink);
  }
  .b-desc {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--ink-soft);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .b-side { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
  .b-tag {
    font-style: normal;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(139, 41, 32, 0.25);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .b-go {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink-faint);
    transition: color 0.2s;
  }
  .b-row:hover .b-go { color: var(--accent); }

  .b-soon {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 22px 10px;
    border-bottom: 1px dashed rgba(0, 0, 0, 0.12);
    opacity: 0.55;
  }
  .b-soon .b-title { color: var(--ink-faint); font-weight: 600; }
  .b-soon .b-tag {
    color: var(--ink-faint);
    border-color: rgba(0, 0, 0, 0.18);
  }

  .back-line { padding-top: 32px; }

  @media (max-width: 700px) {
    .lib-hero h1 { font-size: 1.55rem; }
    .b-row { flex-wrap: wrap; gap: 12px; }
    .b-side { width: 100%; justify-content: flex-end; }
  }
</style>
